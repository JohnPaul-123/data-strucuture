#include <stdio.h>

int main()
{
    int a[10], b[10], c[25];
    int n, m, i;

    printf("Enter the first limit of the array: ");
    scanf("%d", &n);

    printf("Enter the second limit of the array: ");
    scanf("%d", &m);

    printf("Enter the first Array: ");
    for(i=0; i<n; i++)
    {
        scanf("%d", &a[i]);
    }

    printf("Enter the second Array: ");
    for(i=0; i<m; i++)
    {
        scanf("%d", &b[i]);
    }

    for(i=0; i<n; i++)
    {
        c[i] = a[i];
    }

    for(i=0; i<m; i++)
    {
        c[n+i] = b[i];   // ✅ important
    }

    printf("MERGED ARRAY IS: ");

    for(i=0; i<n+m; i++)
    {
        printf("%d ", c[i]);
    }

    return 0;
}
